---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServiceCards from "../components/ServiceCards.astro";
import OurWorkSection from "../components/OurWorkSection.astro";
import body from "../_html/index.body.html?raw";
import { getServices, getWorks } from "../lib/strapi.js";

const services = await getServices();
const works = await getWorks();

// The home page is the raw Webflow body, but its two CMS collection sections
// (Services + Works) exported empty. Split the raw HTML around them and render
// those two sections from live data instead.
const SVC_OPEN = '<section data-wf--section-service--variant="base" class="section_service">';
const ABOUT_OPEN = '<section class="section_about">';
const WORK_OPEN = '<section class="section_our-work">';
const TESTI_OPEN = '<section class="section_testimonial">';

const iSvc = body.indexOf(SVC_OPEN);
const iAbout = body.indexOf(ABOUT_OPEN);
const iWork = body.indexOf(WORK_OPEN);
const iTesti = body.indexOf(TESTI_OPEN);

const pre = body.slice(0, iSvc);      // <main> + hero + logo
const mid = body.slice(iAbout, iWork); // about … why-choose
const post = body.slice(iTesti);      // testimonial … cta + </main>
