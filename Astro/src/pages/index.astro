  <script is:inline>
    (function () {
      var sizeInput = document.getElementById("est-size");
      var sizeValue = document.getElementById("est-size-value");
      var typeSelect = document.getElementById("est-type");
      var materialSelect = document.getElementById("est-material");
      var pitchSelect = document.getElementById("est-pitch");
      var lowEl = document.getElementById("est-low");
      var highEl = document.getElementById("est-high");
      var hintEl = document.getElementById("est-hint");
      var cta = document.getElementById("est-cta");
      if (!sizeInput || !typeSelect || !materialSelect || !pitchSelect) return;

      var RATE = { asphalt: 4.5, metal: 9, tile: 11, flat: 6.5 };
      var RATE_LABEL = { asphalt: "Asphalt Shingles", metal: "Metal", tile: "Tile", flat: "Flat / TPO" };
      var TYPE_MULT = { residential: 1, commercial: 1.15, industrial: 1.3 };
      var PITCH_MULT = { low: 0.95, standard: 1, steep: 1.2 };
      var TYPE_LABEL = { residential: "Residential", commercial: "Commercial", industrial: "Industrial" };

      function formatMoney(n) {
        return "$" + Math.round(n).toLocaleString("en-US");
      }

      function recalc() {
        var size = Number(sizeInput.value);
        sizeValue.textContent = size.toLocaleString("en-US");

        var type = typeSelect.value;
        var material = materialSelect.value;
        var pitch = pitchSelect.value;
        var rate = RATE[material] || RATE.asphalt;
        var typeMult = TYPE_MULT[type] || 1;
        var pitchMult = PITCH_MULT[pitch] || 1;
        var base = size * rate * typeMult * pitchMult;
        var low = Math.round(base * 0.9);
        var high = Math.round(base * 1.15);

        lowEl.textContent = formatMoney(low);
        highEl.textContent = formatMoney(high);
        if (hintEl) {
          hintEl.textContent = TYPE_LABEL[type] + " · " + RATE_LABEL[material] + " · " + size.toLocaleString("en-US") + " sq ft";
        }
        if (cta) {
          cta.href = "/contact?roofType=" + encodeURIComponent(type) +
            "&material=" + encodeURIComponent(material) +
            "&pitch=" + encodeURIComponent(pitch) +
            "&size=" + encodeURIComponent(size) +
            "&estimateLow=" + low +
            "&estimateHigh=" + high;
        }
      }

      [sizeInput, typeSelect, materialSelect, pitchSelect].forEach(function (el) {
        el.addEventListener("input", recalc);
        el.addEventListener("change", recalc);
      });
      recalc();
    })();
  </script>

