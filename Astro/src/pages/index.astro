  <script is:inline>
    (function () {
      var sliders = document.querySelectorAll("[data-ba]");
      sliders.forEach(function (slider) {
        var range = slider.querySelector("[data-ba-range]");
        var afterBlock = slider.querySelector("[data-ba-after]");
        var handle = slider.querySelector("[data-ba-handle]");
        if (!range || !afterBlock || !handle) return;
        function update() {
          var val = range.value;
          afterBlock.style.clipPath = "inset(0 " + (100 - val) + "% 0 0)";
          handle.style.left = val + "%";
        }
        range.addEventListener("input", update);
        update();
      });
    })();
  </script>

