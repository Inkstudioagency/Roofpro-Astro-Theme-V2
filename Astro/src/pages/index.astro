                <option value="steep">Steep / Complex</option>
              </select>
            </div>
            <div id="est-result" class="estimator-result">
              <p class="estimator-result-label">Estimated project cost</p>
              <p class="estimator-result-value"><span id="est-low"></span> – <span id="est-high"></span></p>
              <p class="estimator-result-hint" id="est-hint"></p>
            </div>
            <a href="/contact" id="est-cta" class="primary-button estimator-button w-inline-block">
              <div class="button-text-block">
                <div class="button-text is-1">Get My Free Quote</div>
                <div class="button-text is-2">Get My Free Quote</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
