---
// Renders the position-styled service cards (the children of
// .service-content-block) from CMS data. Used on both the home page and the
// /services listing. Markup matches the RoofPro Webflow export exactly; the
// first card (is-1) carries the image overlays.
//
// TITLE_WID are the original Webflow interaction ids (data-w-id) that bind the
// click animation on each service-item-title-block; they must be preserved for
// the interactions runtime (/js/site.js) to wire the click interaction.
const TITLE_WID = [
  "40031a16-0ef6-ea08-1a16-c5b8c6ec1c2b",
  "40031a16-0ef6-ea08-1a16-c5b8c6ec1c43",
  "40031a16-0ef6-ea08-1a16-c5b8c6ec1c5b",
  "40031a16-0ef6-ea08-1a16-c5b8c6ec1c73",
];
const { services = [] } = Astro.props;
---
{services.map((s, idx) => {
  const n = idx + 1;
  const overlay = n === 1;
  const href = `/services/${s.slug}`;
  return (
    <div class="service-collection-block w-dyn-list">
      <div role="list" class="service-collection-list w-dyn-items">
        <div role="listitem" class="service-collection-item w-dyn-item">
          <div class="service-item-block">
            <div data-w-id={TITLE_WID[idx]} class={`service-item-title-block is-${n}`}>
              <div class="service-title-text-block">
                <div class="service-item-icon-block"><img src={s.serviceItemIcon} loading="lazy" alt="" class={`service-item-icon is-${n}`} /><img src={s.serviceHoverIcon} loading="lazy" alt="" class={`service-hover-icon is-${n}`} /></div>
                <h3 class={`label-medium is-${n}`}>{s.serviceTitle}</h3>
              </div>
              <a href={href} class="service-title-icon-block w-inline-block">
                <div class={`service-title-icon is-${n} w-embed`}><svg width="32" height="32" viewbox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_152_190)"><path d="M22.6663 9.33398L9.33301 22.6673" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M10.667 9.33398H22.667V21.334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></g><defs><clippath id="clip0_152_190"><rect width="32" height="32" fill="currentColor"></rect></clippath></defs></svg></div>
              </a>
            </div>
            <div class={`service-item-content-block is-${n}`}>
              <div class="service-item-image-block">
                <div class="service-item-single-image-block is-1"><img loading="lazy" src={s.serviceThumbnail1} alt="service-item-single-image" class="service-item-single-image" />{overlay && <div class="image-overlay"></div>}</div>
                <div class="service-item-single-image-block is-2"><img loading="lazy" src={s.serviceThumbnail2} alt="service-item-single-image" class="service-item-single-image" />{overlay && <div class="image-overlay"></div>}</div>
              </div>
              <div class="service-item-text-block">
                <h3 class="heading-style-5">{s.serviceTitle}</h3>
                <p class="paragraph-small">{s.serviceDescription}</p>
                <a href={href} class="service-link-button">View Service</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
})}
